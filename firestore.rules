rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // CLOSED TO CLIENTS — no exception, no fallback, ever.
    // =====================================================================
    //
    // `secrets` holds bcrypt PIN hashes and lockout counters. `sessions` holds
    // hashed session tokens. Both are reached exclusively through the
    // firebase-admin SDK in /api, which bypasses these rules by design.
    //
    // PIN hashes used to live in `members`, where `allow read: if true` meant
    // anyone with the public Firebase config could dump all thirteen and crack
    // a 4-digit PIN offline. Denying these two collections is the rules-side
    // half of that fix; scripts/migrate-secrets.mjs is the data-side half.
    match /secrets/{memberId} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // =====================================================================
    // STILL PERMISSIVE — deliberately, and temporarily.
    // =====================================================================
    //
    // These rules are not a security boundary today; they are an audit-trail
    // boundary (no deletes) plus a placeholder. They become real when:
    //
    //   1. the treasurer finishes the Jul-Sep 2026 backfill through the Ledger
    //      Entry flow, which writes from the browser;
    //   2. every money write moves to /api under firebase-admin (PLATFORM-PLAN
    //      section 4.3, Gate 3), at which point `allow write: if false` lands.
    //
    // Until then the honest position is that `allow update: if true` is a real
    // hole — any client could change a member's role or PIN. It is closed
    // application-side today (admin actions go through /api/admin/* with a
    // server-side role check) and rules-side in Gate 3.
    //
    // For per-member authorization, rules need `request.auth`, which means
    // Firebase Auth custom tokens — phase 2 of PLATFORM-PLAN section 4.2.
    // Until then, reads stay permissive and authority is enforced in the API.

    // Members
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if true;
      // No delete allowed — audit trail requirement
      allow delete: if false;
    }

    // Contributions
    match /contributions/{contribId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Fines (late payment, absence, welfare arrears)
    match /fines/{fineId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Bank transactions
    match /bankTransactions/{txId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Investments
    match /investments/{investmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Exit requests
    match /exitRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Meeting minutes
    match /meetingMinutes/{minuteId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Forum posts (includes Announcement and Opportunity categories)
    match /forumPosts/{postId} {
      allow read: if true;
      allow create, update: if true;
      // No delete or edit of existing content in v1
      allow delete: if false;
    }

    // Config / settings
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
