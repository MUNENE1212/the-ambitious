# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# firebase emulator data
/emulator-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase debug logs (contain env info)
firebase-debug.log
firestore-debug.log
firebase.json

# FUSE leftovers from deleted-but-open files on this mount
.fuse_hidden*

# Real membership roster — personal data, never committed
scripts/roster.local.json

# Firestore snapshots from scripts/backup-snapshot.mjs — contain phone numbers
# and PIN hashes, never committed
/backups

# Downloaded Firebase service-account keys. These grant full admin on the
# project — the same standing as the PIN hashes above, and just as damaging if
# they reach a remote. Firebase names them
# <project>-firebase-adminsdk-<suffix>.json, but match on the shape, not the
# name, so a renamed copy is caught too.
*-firebase-adminsdk-*.json
*service-account*.json

# Local agent/assistant guidance (not part of the project)
CLAUDE.md
AGENTS.md

# Research scratch — saved HTML/text pulled during regulatory research
k.out
kl.html
*.debug.log
