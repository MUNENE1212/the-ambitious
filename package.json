{
  "name": "the-ambitious",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_USE_EMULATORS=true next dev",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:seed": "NEXT_PUBLIC_USE_EMULATORS=true node scripts/seed-emulator.mjs",
    "verify:auth": "NEXT_PUBLIC_USE_EMULATORS=true node scripts/verify-auth.mjs",
    "verify:onboarding": "NEXT_PUBLIC_USE_EMULATORS=true node scripts/verify-onboarding.mjs",
    "migrate:secrets": "node scripts/migrate-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --max-warnings 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.2.0",
    "next-pwa": "^5.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "exceljs": "^4.4.0",
    "firebase-tools": "^15.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
